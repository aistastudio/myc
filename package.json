{
  "name": "myc",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@myc/bench": "workspace:*",
    "@myc/core": "workspace:*",
    "@myc/embed": "workspace:*",
    "@myc/retrieval": "workspace:*",
    "@myc/store-sqlite": "workspace:*",
    "bun-types": "^1.3.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "pack:npm": "bun run scripts/pack-npm.ts",
    "coldstart": "bun run scripts/coldstart.ts",
    "deps-check": "bun run scripts/deps-check.ts",
    "bench:latency": "bun run scripts/bench-latency.ts",
    "bench:latency:update-baseline": "bun run scripts/bench-latency.ts --update-baseline",
    "typecheck": "bun run --filter=\"*\" typecheck",
    "test": "bun test",
    "reindex:vectors": "bun run scripts/reindex-vectors.ts",
    "bench:separation": "bun run packages/embed/src/bench-separation.ts"
  },
  "license": "MIT"
}
