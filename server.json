{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aistastudio/myc",
  "description": "Task queue, decisions and memory for coding agents. Local SQLite, no network. Requires Bun.",
  "repository": {
    "url": "https://github.com/aistastudio/myc",
    "source": "github",
    "id": "1360074658"
  },
  "websiteUrl": "https://aistastudio.github.io/myc/",
  "version": "0.3.13",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@aistastudio/myc",
      "version": "0.3.13",
      "runtimeHint": "bunx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "named", "name": "--profile", "value": "agent" }
      ]
    }
  ]
}
